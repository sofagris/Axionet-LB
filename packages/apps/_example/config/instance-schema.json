{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axionet.local/packages/example/instance-schema.json",
  "title": "Example instance desired state",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "bind"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Instance display name"
    },
    "bind": {
      "type": "string",
      "minLength": 1,
      "description": "Listen address, e.g. *:8080"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string" },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
